# URL ของ backend (Java) — คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า
# - เล่นบนเครื่องตัวเอง (web):   http://localhost:8080
# - มือถือ/เครื่องอื่นในวง Wi-Fi: http://<IP เครื่องคอม>:8080
# - production: ตั้งใน Netlify/Vercel เป็น URL ของ Render เช่น https://forbidden-words-api.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:8080
