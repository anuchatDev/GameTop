# ตัวอย่าง environment variable สำหรับ production (ตั้งใน Render / Railway dashboard)
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL แบบ JDBC (Neon / Supabase) — อย่าใส่ user/password ใน URL
DATABASE_URL=jdbc:postgresql://ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=change-me

# สุ่มยาวอย่างน้อย 32 ตัวอักษร เช่น: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# URL ของหน้าเว็บ (frontend) ที่อนุญาตให้เรียก API คั่นด้วย comma
CORS_ORIGINS=https://your-app.netlify.app,https://your-app.vercel.app

# ชื่อผู้ใช้ที่ได้สิทธิ์ Admin อัตโนมัติ คั่นด้วย comma (ให้สิทธิ์ตอน start และตอนสมัคร)
ADMIN_USERNAMES=your-username
